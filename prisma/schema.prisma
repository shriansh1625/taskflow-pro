generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id           String   @id
  boardId      String   @default("shared")
  logicalId    String   @default("")
  title        String
  description  String   @default("")
  column       String
  sortOrder    Int
  plannedStart String
  durationDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predecessors Dependency[] @relation("Successor")
  successors   Dependency[] @relation("Predecessor")

  @@index([boardId])
}

model Dependency {
  predecessorId String
  successorId   String
  boardId       String   @default("shared")
  predecessor   Task     @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task     @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([boardId])
}

/// Fixed window shared by every server that uses this database.
model RateBucket {
  id          String   @id
  windowStart DateTime
  count       Int
}
