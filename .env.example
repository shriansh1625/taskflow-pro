# Local clone, tests, and Docker. Never put a Postgres URL in this file on your laptop
# unless you are intentionally talking to Neon.
DATABASE_URL="file:./dev.db"

# Server-only. Copy to .env. Never commit the real key.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"

# Vercel only (do not set these in local .env if you want SQLite tests):
# DATABASE_URL="postgresql://...@ep-....neon.tech/neondb?sslmode=require"
# Use the DIRECT Neon URI, not the one with -pooler in the hostname.
